   "source": [
    "# 02 - EDA & Customer Segmentation\n",
    "Loads the cleaned data from notebook 01, runs the EDA charts, RFM segmentation and KMeans clustering.\n",
    "\n",
    "**Inputs:** `olist_cleaned_items.csv`, `customer_features.csv`  \n",
    "**Output:** `customer_segments.csv` (customer features + churn flag, RFM scores/segment, KMeans cluster)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2537829b",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mticker\n",
    "\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.metrics import silhouette_score"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "70f774fa",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Mount Google Drive (Colab)\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "drive_path = '/content/drive/MyDrive/olist/'          # <-- raw Olist CSVs (update to your folder)\n",
    "processed_path = drive_path + 'processed/'            # <-- intermediate files shared between notebooks\n",
    "os.makedirs(processed_path, exist_ok=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2e52a444",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# LOAD CLEANED DATA (output of 01_data_cleaning.ipynb)\n",
    "# ==============================================================================\n",
    "full = pd.read_csv(\n",
    "    processed_path + 'olist_cleaned_items.csv',\n",
    "    parse_dates=['order_purchase_timestamp', 'order_delivered_customer_date', 'order_estimated_delivery_date'],\n",
    ")\n",
    "customer_features = pd.read_csv(processed_path + 'customer_features.csv', parse_dates=['last_order'])\n",
    "\n",
    "print(f\"full: {full.shape}  |  customer_features: {customer_features.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c53ee571",
   "metadata": {},
   "source": [
    "## EDA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5c8d45f5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# STEP 3: EDA
    "# ==============================================================================\n",
    "\n",
    "# 1. Monthly revenue -- LINE CHART\n",
    "# Result: shows whether overall revenue is growing, flat, or declining month over month.\n",
    "monthly_revenue = full.set_index(\"order_purchase_timestamp\")[\"total_order_value\"].resample(\"MS\").sum()\n",
    "ax = monthly_revenue.plot(figsize=(9, 4), title=\"Monthly revenue\")\n",
    "plt.ylabel(\"Revenue\")\n",
    "ax.yaxis.set_major_formatter(mticker.StrMethodFormatter(\"R${x:,.0f}\"))\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "94b83c3e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Monthly order count -- LINE CHART\n",
    "# Result: shows whether order volume growth is keeping pace with (or lagging) revenue growth.\n",
    "monthly_orders = full.groupby(full[\"order_purchase_timestamp\"].dt.to_period(\"M\"))[\"order_id\"].nunique()\n",
    "monthly_orders.plot(figsize=(9, 4), title=\"Monthly order volume\", kind=\"line\", marker=\"o\")\n",
    "plt.ylabel(\"Orders\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fabcdcc9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Revenue by category (top 10) -- BAR CHART\n",
    "# Result: shows which categories generate the most revenue -- candidates to protect/invest in.\n",
    "rev_by_cat = full.groupby(\"product_category_name_english\")[\"total_order_value\"].sum().nlargest(10)\n",
    "ax = rev_by_cat.plot(kind=\"bar\", figsize=(9, 4), title=\"Top 10 categories by revenue\")\n",
    "plt.ylabel(\"Revenue\")\n",
    "plt.xticks(rotation=45, ha=\"right\")\n",
    "ax.yaxis.set_major_formatter(mticker.StrMethodFormatter(\"R${x:,.0f}\"))\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4e90e8cf",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Order count by category (top 10) -- BAR CHART\n",
    "# Result: shows which categories drive order volume vs revenue -- high-volume/low-revenue\n",
    "# categories signal cheap, frequent items worth bundling or upselling.\n",
    "orders_by_cat = full.groupby(\"product_category_name_english\")[\"order_id\"].nunique().nlargest(10)\n",
    "orders_by_cat.plot(kind=\"bar\", figsize=(9, 4), title=\"Top 10 categories by order count\")\n",
    "plt.ylabel(\"Orders\")\n",
    "plt.xticks(rotation=45, ha=\"right\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "79b89b72",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Delivery delay & late rate by review score -- side-by-side BAR CHARTS\n",
    "# Result: shows that later deliveries track with lower review scores, and the share of\n",
    "# late orders drops sharply as review score rises -- delivery timing is a satisfaction driver.\n",
    "full[\"review_score_rounded\"] = full[\"review_score\"].round().astype(\"Int64\")\n",
    "bar_colors = [\"#c0392b\", \"#e67e22\", \"#f1c40f\", \"#2ecc71\", \"#27ae60\"]\n",
    "\n",
    "avg_delay = full.groupby(\"review_score_rounded\")[\"delivery_delay_days\"].mean()\n",
    "late_rate = full.groupby(\"review_score_rounded\")[\"is_late\"].mean()\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 4.5))\n",
    "avg_delay.plot(kind=\"bar\", color=bar_colors, ax=axes[0], title=\"Avg delivery delay by review score\")\n",
    "axes[0].set_xlabel(\"Review score\")\n",
    "axes[0].set_ylabel(\"Avg delay vs estimate (days)\")\n",
    "axes[0].axhline(0, color=\"black\", linewidth=0.8)\n",
    "axes[0].tick_params(axis=\"x\", rotation=0)\n",
    "\n",
    "late_rate.plot(kind=\"bar\", color=bar_colors, ax=axes[1], title=\"Late delivery rate by review score\")\n",
    "axes[1].set_xlabel(\"Review score\")\n",
    "axes[1].set_ylabel(\"% of orders delivered late\")\n",
    "axes[1].yaxis.set_major_formatter(mticker.PercentFormatter(1.0))\n",
    "axes[1].tick_params(axis=\"x\", rotation=0)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cf26c9dd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. On-time rate by state (top/bottom) -- BAR CHART\n",
    "# Result: shows which regions have the worst logistics performance -- targets for carrier/route fixes.\n",
    "state_ontime = full.groupby(\"customer_state\")[\"is_late\"].apply(lambda x: 1 - x.mean()).sort_values()\n",
    "state_ontime.head(10).plot(kind=\"bar\", figsize=(9, 4), title=\"10 worst states by on-time delivery rate\", color=\"crimson\")\n",
    "plt.ylabel(\"On-time rate\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3badb331",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7. Payment type distribution -- BAR CHART\n",
    "# Result: shows which payment methods customers rely on -- informs checkout/installment strategy.\n",
    "full[\"payment_type\"].value_counts().plot(kind=\"bar\", figsize=(9, 4), title=\"Orders by payment type\", color=\"teal\")\n",
    "plt.ylabel(\"Orders\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6ea9e20e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 8. Review score distribution -- HISTOGRAM\n",
    "# Result: shows overall customer satisfaction -- a skew toward 1-2 stars signals a systemic problem.\n",
    "review_scores = full[\"review_score\"].dropna()\n",
    "n_missing = full[\"review_score\"].isna().sum()\n",
    "print(f\"Excluding {n_missing} orders with no review score from the distribution below.\")\n",
    "review_scores.plot(kind=\"hist\", bins=5, figsize=(9, 4), title=\"Review score distribution\", color=\"purple\")\n",
    "plt.xlabel(\"Review score\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "554dc180",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 9. One-time vs repeat customers -- BAR CHART\n",
    "# Result: shows the baseline retention problem -- what share of customers never come back.\n",
    "repeat_flag = customer_features[\"frequency\"].apply(lambda f: \"Repeat (2+ orders)\" if f > 1 else \"One-time\")\n",
    "repeat_flag.value_counts().plot(kind=\"bar\", figsize=(6, 4), title=\"One-time vs repeat customers\", color=\"seagreen\")\n",
    "plt.ylabel(\"Customers\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5a59ede2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 10. Freight cost distribution -- HISTOGRAM (clipped at the 99th percentile so the bulk of\n",
    "#     the distribution isn't squeezed flat by a handful of extreme outliers)\n",
    "# Result: shows how much shipping cost eats into order value -- a churn/satisfaction risk if too high.\n",
    "freight_cap = full[\"freight_value\"].quantile(0.99)\n",
    "freight_clipped = full[\"freight_value\"].clip(upper=freight_cap)\n",
    "freight_clipped.plot(kind=\"hist\", bins=40, figsize=(9, 4),\n",
    "                      title=f\"Freight cost distribution (clipped at R${freight_cap:.0f}, 99th pct)\", color=\"brown\")\n",
    "plt.xlabel(\"Freight value\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c2cd27ec",
   "metadata": {},
   "source": [
    "## RFM Segmentation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0de77a44",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# STEP 4: RFM SEGMENTATION\n",
    "# ==============================================================================\n",
    "\n",
    "# Recency distribution, to sanity-check the churn cutoff before it's applied\n",
    "# Result: confirms 120 days sits past most customers' natural reorder window, not mid-distribution.\n",
    "plt.figure(figsize=(9, 4))\n",
    "customer_features[\"recency_days\"].plot(kind=\"hist\", bins=50, color=\"slategray\")\n",
    "plt.axvline(120, color=\"red\", linestyle=\"--\", label=\"120-day cutoff\")\n",
    "plt.xlabel(\"Recency (days since last order)\")\n",
    "plt.title(\"Recency distribution vs. churn cutoff\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "62a7a81a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define churn: no purchase in the last 120 days\n",
    "CHURN_THRESHOLD_DAYS = 120\n",
    "customer_features[\"churn_risk\"] = (customer_features[\"recency_days\"] > CHURN_THRESHOLD_DAYS).astype(int)\n",
    "\n",
    "# Score each customer 1-5 on recency, frequency, monetary value (5 = best)\n",
    "customer_features[\"R_score\"] = pd.qcut(customer_features[\"recency_days\"], 5, labels=[5, 4, 3, 2, 1]).astype(int)\n",
    "customer_features[\"F_score\"] = pd.qcut(customer_features[\"frequency\"].rank(method=\"first\"), 5, labels=[1, 2, 3, 4, 5]).astype(int)\n",
    "customer_features[\"M_score\"] = pd.qcut(customer_features[\"monetary_value\"], 5, labels=[1, 2, 3, 4, 5]).astype(int)\n",
    "customer_features[\"RFM_score\"] = customer_features[\"R_score\"] + customer_features[\"F_score\"] + customer_features[\"M_score\"]\n",
    "\n",
    "\n",
    "# Map the combined score straight to a segment label (higher score = more valuable)\n",
    "def segment(score):\n",
    "    if score >= 13:\n",
    "        return \"Champions\"\n",
    "    if score >= 10:\n",
    "        return \"Loyal customers\"\n",
    "    if score >= 7:\n",
    "        return \"At-risk customers\"\n",
    "    return \"Lost customers\"\n",
    "\n",
    "\n",
    "customer_features[\"segment\"] = customer_features[\"RFM_score\"].apply(segment)\n",
    "\n",
    "# Result: shows how customer value is distributed across segments -- sizes the win-back / loyalty audiences.\n",
    "customer_features[\"segment\"].value_counts().plot(kind=\"bar\", figsize=(9, 4), title=\"Customers per RFM segment\", color=\"slateblue\")\n",
    "plt.ylabel(\"Customers\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e72629c0",
   "metadata": {},
   "source": [
    "## KMeans Clustering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1b6be5f9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# STEP 5: KMEANS CLUSTERING (Unsupervised Behavioral Segmentation)\n",
    "# ==============================================================================\n",
    "\n",
    "# 1. Feature selection and scaling\n",
    "cluster_features = [\n",
    "    \"recency_days\", \"frequency\", \"monetary_value\",\n",
    "    \"average_order_value\", \"late_order_rate\", \"average_review_score\"\n",
    "]\n",
    "X_cluster = customer_features[cluster_features].fillna(customer_features[cluster_features].median())\n",
    "scaler_cluster = StandardScaler()\n",
    "X_cluster_scaled = scaler_cluster.fit_transform(X_cluster)\n",
    "\n",
    "# 2. Evaluate optimal clusters using Elbow Method & Silhouette Score\n",
    "#Evaluates cluster cohesion and separation across k to confirm the best cluster count\n",
    "inertias, sil_scores = [], []\n",
    "k_range = range(2, 9)\n",
    "\n",
    "for k in k_range:\n",
    "    km = KMeans(n_clusters=k, random_state=42, n_init=10).fit(X_cluster_scaled)\n",
    "    inertias.append(km.inertia_)\n",
    "    sil_scores.append(silhouette_score(X_cluster_scaled, km.labels_,sample_size=10000, random_state=42))\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "axes[0].plot(k_range, inertias, marker=\"o\", color=\"royalblue\")\n",
    "axes[0].set_title(\"Elbow Method (Inertia vs k)\")\n",
    "axes[0].set_xlabel(\"Number of Clusters (k)\")\n",
    "axes[0].set_ylabel(\"Inertia\")\n",
    "\n",
    "axes[1].plot(k_range, sil_scores, marker=\"s\", color=\"darkorange\")\n",
    "axes[1].set_title(\"Silhouette Score vs k\")\n",
    "axes[1].set_xlabel(\"Number of Clusters (k)\")\n",
    "axes[1].set_ylabel(\"Silhouette Score\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 3. Fit final KMeans model (k=4 to 5 based on plots)\n",
    "optimal_k = 4\n",
    "kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)\n",
    "customer_features[\"cluster\"] = kmeans.fit_predict(X_cluster_scaled)\n",
    "\n",
    "# 4. Profile clusters and cross-tabulate against RFM segments\n",
    "cluster_profile = customer_features.groupby(\"cluster\")[cluster_features].mean().round(2)\n",
    "cluster_profile[\"customer_count\"] = customer_features[\"cluster\"].value_counts()\n",
    "print(\"--- KMeans Cluster Profiles ---\")\n",
    "display(cluster_profile)\n",
    "\n",
    "crosstab_rfm_cluster = pd.crosstab(customer_features[\"segment\"], customer_features[\"cluster\"])\n",
    "print(\"\\n--- RFM Segment vs KMeans Cluster Crosstab ---\")\n",
    "display(crosstab_rfm_cluster)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7fe69988",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# SAVE SEGMENTED DATA for the model notebook\n",
    "# ==============================================================================\n",
    "customer_features.to_csv(processed_path + 'customer_segments.csv', index=False)\n",
    "print(f\"Saved customer_segments.csv ({customer_features.shape[0]} rows, {customer_features.shape[1]} columns)\")"
   ]
  }
